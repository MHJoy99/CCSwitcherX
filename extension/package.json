{
  "name": "claude-accounts",
  "displayName": "Claude Accounts (CCSwitcherX)",
  "description": "Switch what Claude Code uses from the status bar: your saved accounts (for example Personal and Team, with each account's usage) or a provider (another model gateway).",
  "version": "1.3.0",
  "publisher": "local",
  "license": "MIT",
  "author": { "name": "MHJoy99", "url": "https://github.com/MHJoy99" },
  "homepage": "https://mhjoy99.github.io/CCSwitcherX/",
  "repository": { "type": "git", "url": "https://github.com/MHJoy99/CCSwitcherX.git" },
  "bugs": { "url": "https://github.com/MHJoy99/CCSwitcherX/issues" },
  "keywords": ["claude", "claude code", "account switcher", "multiple accounts", "usage", "provider", "gateway"],
  "private": true,
  "icon": "icon.png",
  "engines": { "vscode": "^1.94.0" },
  "categories": ["Other"],
  "extensionKind": ["ui"],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      { "command": "claudeAccounts.switch", "title": "Switch account or provider", "category": "Claude Accounts", "icon": "$(account)" },
      { "command": "claudeAccounts.add", "title": "Add account…", "category": "Claude Accounts" },
      { "command": "claudeAccounts.saveCurrent", "title": "Save current login…", "category": "Claude Accounts" },
      { "command": "claudeAccounts.openManager", "title": "Open manager window", "category": "Claude Accounts" },
      { "command": "claudeAccounts.doctor", "title": "Run self-check", "category": "Claude Accounts" },
      { "command": "claudeAccounts.showLog", "title": "Show log", "category": "Claude Accounts" }
    ],
    "configuration": {
      "title": "Claude Accounts",
      "properties": {
        "claudeAccounts.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Python command used to run the Claude Accounts engine."
        },
        "claudeAccounts.appDir": {
          "type": "string",
          "default": "",
          "description": "Folder that holds claude_accounts.py. Leave empty for ~/.claude-accounts."
        }
      }
    }
  }
}
